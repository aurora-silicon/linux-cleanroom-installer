// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Apple MacBook Air (13-inch, M4, 2025)
 *
 * target-type: J713
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t8132.dtsi"
#include "t8132-jxxx.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/spmi/spmi.h>

/ {
	compatible = "apple,j713", "apple,t8132", "apple,arm-platform";
	model = "Apple MacBook Air (13-inch, M4, 2024)";

	aliases {
		ans = &nvme;
		ans-mbox = &ans_mbox;
		keyboard = &keyboard;
		nvram = &nvram;
		pmu-primary = &pmic1;
		pmp = &pmp;
		sart-ans = &sart;
		spmi-primary = &nub_spmi;
		wifi0 = &wifi0;
	};

	chosen {
		linux-enablement-mac,disk-boot;
		linux-enablement-mac,dapf-handoff = "/arm-io/aop", "/arm-io/mtp",
			"/arm-io/pmp";
		linux-enablement-mac,dapf-power-on-handoff = "/arm-io/pmp";
	};

	led-controller {
		compatible = "pwm-leds";
		led-0 {
			pwms = <&fpwm1 0 40000>;
			label = "kbd_backlight";
			function = LED_FUNCTION_KBD_BACKLIGHT;
			color = <LED_COLOR_ID_WHITE>;
			max-brightness = <255>;
			default-state = "keep";
		};
	};
};

&qspi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
		spi-rx-bus-width = <1>;
		spi-tx-bus-width = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			nvram: partition@700000 {
				label = "nvram";
				/* J713 ADT /arm-io/qspi/spinor/anvram, flash-relative. */
				reg = <0x700000 0x100000>;
			};
		};
	};
};

/*
 * m1n1 performs the T8132 controller and PHY initialization. Linux adopts
 * the trained link and owns DART stream 16, RID-to-SID routing and MSI.
 *
 * AURORA_TODO: Determine and validate the T8132 DART fault interrupt, then
 * describe it on dart_apcie0 and make it mandatory in the binding.
 */
&soc {
	nub_spmi_a0: spmi@388908000 {
		compatible = "apple,t8132-spmi", "apple,t8103-spmi";
		reg = <0x3 0x88908000 0x0 0x4000>;
		#address-cells = <2>;
		#size-cells = <0>;
		#interrupt-cells = <2>;
		interrupt-controller;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 520 IRQ_TYPE_LEVEL_HIGH>;

		hpm1: usb-pd@a {
			compatible = "apple,t8132-sn201202x", "apple,sn201202x";
			reg = <0xa SPMI_USID>;
			interrupts = <37 IRQ_TYPE_EDGE_RISING>,
				     <43 IRQ_TYPE_EDGE_RISING>,
				     <45 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "irq", "sleep", "wake";

			typec1: connector {
				compatible = "usb-c-connector";
				label = "USB-C MagSafe-adjacent";
				power-role = "dual";
				data-role = "dual";

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						typec1_connector_hs: endpoint {
							remote-endpoint = <&dwc3_1_hs>;
						};
					};

					port@1 {
						reg = <1>;
						typec1_connector_ss: endpoint {
							remote-endpoint = <&atcphy1_typec_lanes>;
						};
					};
				};
			};
		};

		hpm0: usb-pd@c {
			compatible = "apple,t8132-sn201202x", "apple,sn201202x";
			reg = <0xc SPMI_USID>;
			interrupts = <11 IRQ_TYPE_EDGE_RISING>,
				     <17 IRQ_TYPE_EDGE_RISING>,
				     <19 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "irq", "sleep", "wake";

			typec0: connector {
				compatible = "usb-c-connector";
				label = "USB-C native client";
				power-role = "dual";
				data-role = "dual";

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						typec0_connector_hs: endpoint {
							remote-endpoint = <&dwc3_0_hs>;
						};
					};

					port@1 {
						reg = <1>;
						typec0_connector_ss: endpoint {
							remote-endpoint = <&atcphy0_typec_lanes>;
						};
					};
				};
			};
		};
	};

	pmp_dart: iommu@380300000 {
		compatible = "apple,t8132-dart", "apple,t8110-dart";
		reg = <0x3 0x80300000 0x0 0xc000>;
		#iommu-cells = <1>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 881 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_pmp>;
	};

	pmp_report: pmp-report@3803c0000 {
		compatible = "apple,t8132-pmp-v2-report";
		reg = <0x3 0x803c0000 0x0 0x20000>;
		power-domains = <&ps_pms_sram>;
	};

	pmp: pmp@380500000 {
		compatible = "apple,t8132-pmp-v2", "apple,t6000-pmp-v2";
		reg = <0x3 0x80500000 0x0 0x80000>,
		      <0x3 0x80e00000 0x0 0x4000>;
		reg-names = "pmp", "asc";
		mboxes = <&pmp_mbox>;
		mbox-names = "mbox";
		iommus = <&pmp_dart 0>;
		power-domains = <&ps_pmp>;
		/* m1n1 supplies board/DRAM parameters and tunables before enabling. */
		status = "disabled";
	};

	pmp_mbox: mailbox@380e08000 {
		compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
		reg = <0x3 0x80e08000 0x0 0x4000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 877 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 878 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 879 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 880 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "send-empty", "send-not-empty",
				  "recv-empty", "recv-not-empty";
		#mbox-cells = <0>;
		power-domains = <&ps_pmp>, <&ps_pms_sram>;
	};

	/* USB2-only path for the port away from MagSafe. */
	atcphy0: phy@402a90000 {
		compatible = "apple,t8132-atcphy";
		reg = <0x4 0x02a90000 0x0 0x4000>,
		      <0x4 0x02a84000 0x0 0x4000>;
		reg-names = "usb2phy", "pipehandler";

		#phy-cells = <1>;
		#reset-cells = <0>;
		orientation-switch;
		mode-switch;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				atcphy0_typec_lanes: endpoint {
					remote-endpoint = <&typec0_connector_ss>;
				};
			};
		};
	};

	dwc3_0_dart_0: iommu@402f00000 {
		compatible = "apple,t8132-dart", "apple,t8110-dart";
		reg = <0x4 0x02f00000 0x0 0xc000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1283 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
	};

	dwc3_0_dart_1: iommu@402f80000 {
		compatible = "apple,t8132-dart", "apple,t8110-dart";
		reg = <0x4 0x02f80000 0x0 0xc000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1283 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
	};

	dwc3_0: usb@402280000 {
		compatible = "apple,t8132-dwc3";
		reg = <0x4 0x02280000 0x0 0xcd00>,
		      <0x4 0x0228cd00 0x0 0x3200>;
		reg-names = "dwc3-core", "dwc3-apple";
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1279 IRQ_TYPE_LEVEL_HIGH>;

		dr_mode = "otg";
		maximum-speed = "high-speed";
		usb-role-switch;
		role-switch-default-mode = "host";

		iommus = <&dwc3_0_dart_0 0>, <&dwc3_0_dart_1 1>;
		resets = <&atcphy0>;
		phys = <&atcphy0 PHY_TYPE_USB2>;
		phy-names = "usb2-phy";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				dwc3_0_hs: endpoint {
					remote-endpoint = <&typec0_connector_hs>;
				};
			};
		};
	};

	atcphy1: phy@40aa90000 {
		compatible = "apple,t8132-atcphy";
		reg = <0x4 0x0aa90000 0x0 0x4000>,
		      <0x4 0x0aa84000 0x0 0x4000>;
		reg-names = "usb2phy", "pipehandler";

		#phy-cells = <1>;
		#reset-cells = <0>;
		orientation-switch;
		mode-switch;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				atcphy1_typec_lanes: endpoint {
					remote-endpoint = <&typec1_connector_ss>;
				};
			};
		};
	};

	dwc3_1_dart_0: iommu@40af00000 {
		compatible = "apple,t8132-dart", "apple,t8110-dart";
		reg = <0x4 0x0af00000 0x0 0xc000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1345 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
	};

	dwc3_1_dart_1: iommu@40af80000 {
		compatible = "apple,t8132-dart", "apple,t8110-dart";
		reg = <0x4 0x0af80000 0x0 0xc000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1345 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
	};

	dwc3_1: usb@40a280000 {
		compatible = "apple,t8132-dwc3";
		reg = <0x4 0x0a280000 0x0 0xcd00>,
		      <0x4 0x0a28cd00 0x0 0x3200>;
		reg-names = "dwc3-core", "dwc3-apple";
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1341 IRQ_TYPE_LEVEL_HIGH>;

		dr_mode = "otg";
		maximum-speed = "high-speed";
		usb-role-switch;
		role-switch-default-mode = "host";

		iommus = <&dwc3_1_dart_0 0>, <&dwc3_1_dart_1 1>;
		resets = <&atcphy1>;
		phys = <&atcphy1 PHY_TYPE_USB2>;
		phy-names = "usb2-phy";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				dwc3_1_hs: endpoint {
					remote-endpoint = <&typec1_connector_hs>;
				};
			};
		};
	};

	dart_apcie0: iommu@490000000 {
		compatible = "apple,t8132-dart", "apple,t8110-dart";
		reg = <0x4 0x90000000 0x0 0x20000>;
		#iommu-cells = <1>;
		apple,dma-range = <0x100 0x00010000 0x0 0x3fe00000>;
	};

	pcie0: pcie@1cb0000000 {
		compatible = "apple,t8132-pcie";
		device_type = "pci";

		reg = <0x1c 0xb0000000 0x0 0x10000000>, /* config */
		      <0x4 0x94000000 0x0 0x4000>,     /* common */
		      <0x4 0x90028000 0x0 0x8000>,     /* port 0 */
		      <0x4 0x97020000 0x0 0x4000>;     /* port 0 PHY glue */
		reg-names = "config", "rc", "port0", "phy0";

		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1231 IRQ_TYPE_LEVEL_HIGH>;

		msi-controller;
		msi-parent = <&pcie0>;
		msi-ranges = <&aic AIC_IRQ 1506 IRQ_TYPE_EDGE_RISING 32>;

		iommu-map = <0x100 &dart_apcie0 16 1>;
		iommu-map-mask = <0xff00>;

		bus-range = <0 1>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges = <0x43000000 0xb 0xc0000000
			  0xb 0xc0000000 0x0 0x20000000>,
			 <0x02000000 0x0 0x80000000
			  0xb 0x80000000 0x0 0x40000000>;

		port00: pci@0,0 {
			device_type = "pci";
			reg = <0x0 0x0 0x0 0x0 0x0>;
			bus-range = <1 1>;
			pwren-gpios = <&smc_gpio 0x13 GPIO_ACTIVE_HIGH>;
			reset-gpios = <&pinctrl_ap 163 GPIO_ACTIVE_LOW>;

			#address-cells = <3>;
			#size-cells = <2>;
			ranges;

			interrupt-controller;
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
					<0 0 0 2 &port00 0 0 0 1>,
					<0 0 0 3 &port00 0 0 0 2>,
					<0 0 0 4 &port00 0 0 0 3>;

			wifi0: wifi@0,0 {
				compatible = "pci14e4,4434";
				reg = <0x10000 0x0 0x0 0x0 0x0>;
				brcm,board-type = "apple,garden";
				local-mac-address = [00 00 00 00 00 00];
				apple,antenna-sku = "XX";
			};
		};
	};
};

&fpwm1 {
	status = "okay";
};

&smc {
	status = "okay";

	hwmon {
		compatible = "apple,smc-hwmon";
		apple,thermal-pressure-key = "mTPL";

		temperature-TB0T {
			apple,key-id = "TB0T";
			label = "Battery Hotspot";
		};

		temperature-TCHP {
			apple,key-id = "TCHP";
			label = "Charge Regulator Temp";
		};

		temperature-TH0x {
			apple,key-id = "TH0x";
			label = "NAND Flash Temperature";
		};

		temperature-TW0P {
			apple,key-id = "TW0P";
			label = "WiFi/BT Module Temp";
		};
	};

	rtc {
		compatible = "apple,smc-rtc";
		nvmem-cells = <&rtc_offset>;
		nvmem-cell-names = "rtc_offset";
	};

	reboot {
		compatible = "apple,t8132-smc-reboot", "apple,smc-reboot";
		nvmem-cells = <&shutdown_flag>, <&boot_stage>,
			<&boot_error_count>, <&panic_count>;
		nvmem-cell-names = "shutdown_flag", "boot_stage",
			"boot_error_count", "panic_count";
	};
};

&smc_mbox {
	status = "okay";
};

&nub_spmi {
	status = "okay";

	pmic1: pmic@0 {
		compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
		reg = <0x0 SPMI_USID>; /* To be filled by loader */

		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			rtc_offset: rtc-offset@2100 {
				reg = <0x2100 0x6>;
			};

			boot_stage: boot-stage@f801 {
				reg = <0xf801 0x1>;
			};

			boot_error_count: boot-error-count@f802,0 {
				reg = <0xf802 0x1>;
				bits = <0 4>;
			};

			panic_count: panic-count@f802,4 {
				reg = <0xf802 0x1>;
				bits = <4 4>;
			};

			shutdown_flag: shutdown-flag@f80f,3 {
				reg = <0xf80f 0x1>;
				bits = <3 1>;
			};
		};
	};
};

&mtp {
	status = "okay";
};

&mtp_mbox {
	status = "okay";
};

&mtp_dart {
	status = "okay";
};

&mtp_dockchannel {
	status = "okay";
};

&mtp_hid {
	apple,afe-reset-gpios = <&smc_gpio 28 GPIO_ACTIVE_LOW>;
	apple,stm-reset-gpios = <&smc_gpio 29 GPIO_ACTIVE_LOW>;

	multi-touch {
		firmware-name = "apple/tpmtfw-j713.bin";
		apple,power-method = <2>;
	};

	keyboard: keyboard {
		hid-country-code = <0>;
		apple,keyboard-layout-id = <0>;
	};

	stm {
	};
};

/*
 * These blocks are initialized and retained by iBoot/DCP. Linux does not yet
 * own the T8132 display power sequence, and the GPIO block must remain live
 * for inherited firmware and input state.
 */
&framebuffer0 {
	/delete-property/ power-domains;
};

&pinctrl_ap {
	/delete-property/ power-domains;
};

&ps_pmp {
	apple,inherited-on;
};

&ps_pms_sram {
	apple,inherited-on;
};

#include "t8132-j713-gpu.dtsi"
