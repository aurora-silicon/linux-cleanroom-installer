# J700 (MacBook Neo, T8140) base fragment.
#
# Merge after defconfig, asahi.config and j700-radio.config, then add the device-parity fragment:
#   make defconfig
#   scripts/kconfig/merge_config.sh -m .config arch/arm64/configs/asahi.config arch/arm64/configs/j700-radio.config
#   make olddefconfig
#   scripts/kconfig/merge_config.sh -m .config arch/arm64/configs/j700.config arch/arm64/configs/j700-device-parity.config
#   make olddefconfig
# The result is the configuration the J700 kernel is tested with.

# Boot NOR (nvram) access for boot-volume switching, and the PMU RTC wake alarm
CONFIG_SPI_APPLE_QSPI=m
CONFIG_RTC_DRV_APPLE_PMU=m

# Classic Bluetooth profiles (headsets, tethering)
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y

# Distribution firmware files are compressed
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# 48-bit virtual addresses; KASLR is untested on this machine
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_RANDOMIZE_BASE is not set

# Boot path and platform built in, so storage, keyboard, SMC and USB do not depend on the initramfs
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_APPLE=y
CONFIG_APPLE_SART=y
CONFIG_APPLE_RTKIT_HELPER=y
CONFIG_BTRFS_FS=y
CONFIG_APPLE_DOCKCHANNEL=y
CONFIG_HID_DOCKCHANNEL=y
CONFIG_HID_APPLE=y
CONFIG_HID_MAGICMOUSE=y
CONFIG_SPMI_APPLE=y
CONFIG_NVMEM_APPLE_SPMI=y
CONFIG_MFD_MACSMC=y
CONFIG_GPIO_MACSMC=y
CONFIG_POWER_RESET_MACSMC=y
CONFIG_SENSORS_MACSMC_HWMON=y
CONFIG_I2C_APPLE=y
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_APPLE_WATCHDOG=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_PHY_APPLE_ATC=y
CONFIG_USB_DWC3_APPLE=y
CONFIG_TYPEC=y
CONFIG_TYPEC_SN201202X=y
CONFIG_MUX_APPLE_DPXBAR=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_ZRAM=y
CONFIG_UHID=y
CONFIG_RFKILL=y
CONFIG_THERMAL_NETLINK=y
CONFIG_NVME_HWMON=y

# J700 driver choices
CONFIG_APPLE_CLPC=m
CONFIG_APPLE_PMP=y
CONFIG_DRM_ACCEL=y
CONFIG_DRM_ACCEL_ANE=m
# CONFIG_HID_APPLE_MTP_HAPTIC is not set
CONFIG_IIO=m
# CONFIG_IIO_AOP_SENSOR_LAS is not set
# CONFIG_USB4 is not set

# Per-process 4K user pages on the 16K kernel (x86 emulation)
CONFIG_ARM64_USER4K_EXPERIMENTAL=y

# USB Ethernet built in, for a wired link before modules load
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_RTL8152=y
CONFIG_USB_UAS=m

# Crypto that Bluetooth and Wi-Fi need early
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y

# Utilisation clamping
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# LSMs named in CONFIG_LSM
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y

# dma-buf heaps and udmabuf (camera and GPU buffer sharing)
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y

# Debugging aids kept in the tested configuration
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y

# Match the tested kernel image: no relative relocation packing, no SCM version suffix
# CONFIG_RELR is not set
# CONFIG_LOCALVERSION_AUTO is not set
