# J700 (MacBook Neo, T8140) device-parity fragment.
#
# Brings the J700 configuration to device and feature parity with a general-purpose
# distribution kernel (reference: Fedora Asahi Remix 44, 7.1.13-402.asahi.fc44.aarch64+16k):
# drivers for devices that can attach over USB or Bluetooth, and common protocols,
# filesystems and features. Most entries are modules. Nothing here changes an option
# that defconfig, asahi.config, j700-radio.config or j700.config set.
#
# Merge after j700.config; see that file for the full sequence.

# Prerequisites of the entries below: nftables core, hidraw, uinput and the ALSA sequencer
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_NAT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_HIDRAW=y
CONFIG_INPUT_UINPUT=m
CONFIG_SND_SEQUENCER=m
CONFIG_SND_HRTIMER=m
CONFIG_SND_SEQ_DUMMY=m
CONFIG_SND_SEQ_HRTIMER_DEFAULT=y

