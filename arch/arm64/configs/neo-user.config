# Merge into the qualified Aurora J700 configuration for user builds.
CONFIG_VIDEO_APPLE_ISP=m
CONFIG_HIDRAW=y
CONFIG_UHID=m
CONFIG_INPUT_UINPUT=m
CONFIG_USB_UAS=m
CONFIG_USB_PRINTER=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_SONY=m
CONFIG_HID_STEAM=m
CONFIG_HID_WACOM=m
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_ZSMALLOC=m
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_PSI=y
CONFIG_SECURITY_YAMA=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y

# Keep Apple firmware external; Wi-Fi waits for real-root availability.
CONFIG_MT7932_FULLMAC=m
CONFIG_SPI_APPLE_QSPI=m
CONFIG_INFINIBAND=m
CONFIG_INFINIBAND_USER_MAD=m
CONFIG_INFINIBAND_USER_ACCESS=m
CONFIG_RDMA_RXE=m
CONFIG_RDMA_SIW=m

# SEP (Touch ID, persistent biometric stores shared with macOS) waits for
# dedicated qualification on Neo; aurora-wip now enables it on J700.
# CONFIG_APPLE_SEP is not set

# The shared kernel also boots the MacBook Air M4 (10 cores).
CONFIG_NR_CPUS=16

# MacBook Air M4 (J713) GPU: retained-firmware owner, Asahi-ABI render node
CONFIG_APPLE_GFX_TVM=y
CONFIG_DRM_APPLE_M4_GPU=m
CONFIG_DRM_APPLE_M4_GPU_POWER=m

# MacBook Air M4 (J713) internal display: retained DCP owner and native KMS
CONFIG_DRM_APPLE_M4_READY=m

# MacBook Pro 14-inch M3 Pro (J514S): G15S GPU owner behind the same
# render-node frontend; its internal display uses DRM_APPLE_M4_READY.
CONFIG_DRM_APPLE_G15=m
